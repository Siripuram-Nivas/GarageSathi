# ── Server ───────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# MongoDB Atlas. If empty, GarageSathi uses a local JSON store (data/db.json).
# Example: mongodb+srv://user:pass@cluster.mongodb.net/garagesathi
MONGODB_URI=

# Comma separated allowed origins for CORS (dev default: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Enables POST /api/demo/reset. Keep false in production.
DEMO_MODE=true

# ── Gnani AI ─────────────────────────────────────────────────────────────
# mock = no network calls, no credits consumed. live = real Gnani calls.
AI_PROVIDER_MODE=mock

# Full secret of the existing "GarageSathi" API key (STT + TTS scopes).
# NEVER commit this value. Leave empty to stay in mock mode.
GNANI_API_KEY_ID=

# Required gate for the one-time live smoke test in AI Integration Status.
ALLOW_GNANI_LIVE_TESTS=false

GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGUAGE=te-IN,en-IN
GNANI_STT_FORMAT=transcribe
GNANI_STT_KEYTERMS_ENABLED=true
GNANI_STT_TOPIC=Telugu-English two-wheeler repair complaints and garage service requests

GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Varuni
GNANI_TTS_LANGUAGE=te-IN

# ── Optional Gnani Evon v3.3 (remote OpenAI-compatible endpoint only) ─────
EVON_ENABLED=false
EVON_BASE_URL=
EVON_API_KEY=
EVON_MODEL=gnani/gnani-evon-v3.3-30B-A3B

# ── Frontend (client/.env) ───────────────────────────────────────────────
# VITE_API_URL=http://localhost:4000
